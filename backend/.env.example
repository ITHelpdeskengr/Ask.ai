# ============================================================
# CHATBOT APP - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB (Free tier: https://www.mongodb.com/atlas)
# Sign up → Create Free Cluster → Get connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatbot?retryWrites=true&w=majority

# Groq AI API (FREE - fast inference, no credit card required)
# Sign up at: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Settings
APP_NAME=AI Assistant
BOT_NAME=ARIA

# Email (Optional - Gmail SMTP, free)
# Enable 2FA on Gmail → App Passwords → Generate password
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=your.email@gmail.com

# Microsoft Teams Webhook (Optional - free)
# In Teams → Channel → Connectors → Incoming Webhook → Copy URL
MS_TEAMS_WEBHOOK_URL=https://your-org.webhook.office.com/webhookb2/xxx

# Frontend URL (for CORS - update after deployment)
FRONTEND_URL=http://localhost:5173

# JWT Secret (generate a random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Render deployment URL (update after deploy)
RENDER_URL=https://your-app.onrender.com

# Google Service Account (for Domain-Wide Delegation)
# Get these from the JSON key file in Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_ADMIN_USER=admin@your-domain.com

# Security Challenge (optional)
# Set to 'true' to completely disable the 6-digit email verification challenge
DISABLE_SECURITY_CHALLENGE=false
